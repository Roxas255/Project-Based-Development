  m_Script: {fileID: 11500000, guid: 940b8aa489875c840aeae1d0302efd86, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialouge
  textComponent: {fileID: 1058348248}
  lines:
  - Those hot spots show where heat is escaping from the house. This leads to energy
    loss throughout the building.
  - Click the Thermal Vision Button again to turn the thermal view off.
  spanishLines:
  - "Esos puntos calientes muestran por d\xF3nde se escapa el calor de la casa. Esto
    provoca p\xE9rdida de energ\xEDa en todo el edificio."
  - "Haz clic de nuevo en el bot\xF3n de Visi\xF3n T\xE9rmica para desactivar la
    vista t\xE9rmica."
  textSpeed: 0.05
  Panel: {fileID: 622703254}
  button: {fileID: 2041556874}
